<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Desenvolvedor</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
       body {
    background-color: #0b080b;
    color: #F4EDF3;
    font-family: Arial, sans-serif;
}

.perfil {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 0;
    padding: clamp(24px, 5vw, 48px) 20px;
}

.perfil h1,
.perfil p {
    max-width: 100%;
    overflow-wrap: anywhere;
}

.avatar {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    border: 3px solid #A875A0;
    object-fit: cover;
}

.perfil a {
    color: #A875A0;
    margin-top: 12px;
}
    </style>
</head>
<body>
    <main class="perfil">
    <img src="<%= usuario.avatar_url %>" alt="Foto de perfil" class="avatar">

    <h1><%= usuario.name || usuario.login %></h1>

    <p><%= usuario.bio || 'Desenvolvedor em formação' %></p>

    <a href="<%= usuario.html_url %>" target="_blank" rel="noopener noreferrer">
        Ver perfil no GitHub
    </a>
</main>



    <%- include('partials/footer') %>
    <%- include('partials/menu.ejs') %>
</body>
</html>