<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="css/style.css">   
   
    <style>
        body{
            background-color:#0b080b;
             margin: 0;
             min-height: 100vh;
             padding: 20px 16px 64px;
             display: flex; 
             justify-content: center; 
             align-items: center;     
             background-image: 
            radial-gradient(circle at 20% 40%, rgba(168, 117, 160, 0.22) 0%,transparent 50%),
            radial-gradient(circle at 80% 60%,rgba(100, 80, 150, 0.18) 0%,transparent 50%);
            position: relative;
            overflow-x: hidden;
            overflow-y: auto;
        }
        .login{
            font-size:50px
        }
        .textos{
          color:#F4EDF3;
         
        }
        .button{
            border-radius: 6px;
            height: 30px;
            width:  70px;
            background-color:#211720;
            border:none;
            color:#B7A8B5;
            cursor:pointer; 

        }
        .button:hover{
            filter:brightness(1.3)
        }
        form{
            border:4px solid #51404F;
            border-radius:30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 10px;
            gap: 10px;    
            width:min(100%, 400px);
        
        }
       .container {
        display: flex;
        width: 100%;
        justify-content: center;
        }   
        input{
            margin-top:3px;
            border:2px solid #51404F;   
            border-radius:10px;
            height:20px;
            width: min(100%, 320px);
            background-color:rgb(89, 62, 97);
            color:#B7A8B5;
        }

        @media (max-width: 480px) {
            .login {
                font-size: 2.4rem;
            }
        }
       
    </style>
</head>
<body>
    
    <div class="container">
  <form class="centro" action="/login" method="POST">
        <h3 class="textos login" >LOGIN</h3>
        <label for="email" class="textos"><strong>Informe seu email:</strong></label>
        <input type="email" name="email" id="email" placeholder="insira seu email." autocomplete="email" required autofocus class="textos">
        <label for="senha" class="textos"><strong>Insira sua senha:</strong></label>
        <input type="password" name="senha" id="senha" placeholder="Insira sua senha." autocomplete="current-password" required class="textos">
        <button type="submit" class="button">Login</button>
        <a href="/resetpassword">Esqueceu sua senha?</a>
        <a href="/register" >Não possui conta? Registre-se</a>
    </form>
  
    </div>
  
    <%- include('partials/footer') %>
</body>
</html>