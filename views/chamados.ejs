<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tela inicial</title>
    <link rel="stylesheet" href="css/style.css">   
     <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=edit" />
    <style> 
    body{
        background-color:#0b080b;
    }
    .textoSec{
        color:#B7A8B5;
    }
     .container {
        display: flex;
        justify-content: center;
        }   
        .textoPrin{
            color:#F4EDF3;
        }
      .aberto {
    border-left: 4px solid #FBBF24;
}

.em_andamento {
    border-left: 4px solid #FB923C;
}

.resolvido {
    border-left: 4px solid #4ADE80;
}
.chamado {
    width: 100%;
    box-sizing: border-box;
    background-color: #160f15;
    color: #F4EDF3;
    border: 1px solid #51404F;
    border-radius: 8px;
    padding: 12px;
}
.main-content {
    margin-left: 220px;
    padding: 30px;
}
.detalhes-chamado {
    color: #B7A8B5;
    margin-top: 12px;
}
.lista-chamados {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: start
}
.botao{
    background:none;
    border:none;
    color:#F4EDF3;
    cursor:pointer;
}
.form-edicao {
    display: none;
}

.form-edicao.aberto {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
    </style>
</head>
<body>
    <p class="textoSec">logados</p>
    <form method="POST" action="/logout">
        <button type="submit">Deslogar</button>
    </form>
    <main class="main-content">
        <div class="lista-chamados">
        <% chamados.forEach(chamado=>{ %>
            <div class="chamado <%=chamado.prioridade %>">
                <details>
                    <summary><h3><%=chamado.titulo %></h3> <button class="botao" onclick="abrirEdicao(<%= chamado.id %>)"><span class="material-symbols-outlined">edit</span></button></summary>
                 
                      <div class="detalhes-chamado">
                      <p><%= chamado.descricao %></p>
                      <p>Prioridade: <%= chamado.prioridade %></p>
                      <p>Status: <%= chamado.status %></p>
                      <p>Aberto em: <%= chamado.criado_em %></p>
                      
                     </div>
                </details>
                    <form id="form-edicao-<%=chamado.id%>" class="form-edicao" action="/editar/<%= chamado.id %>" method="POST">
                    <input type="text" value="<%=chamado.titulo %>" name="titulo">
                     <textarea name="descricao"><%=chamado.descricao%></textarea>
        <select name="prioridade">
             <option value="critica">Crítica</option>
            <option value="alta">Alta</option>
            <option value="media">Média</option>
            <option value="baixa">Baixa</option>    
        </select>

         <button type="submit">
                Salvar
            </button>
    </form>
               
            </div>
       <% }) %>
    </div>
    </main>

<%- include('partials/menu') %>
    <script>
        
function abrirEdicao(id) {
    const formulario = document.getElementById(`form-edicao-${id}`);
    formulario.classList.toggle('aberto');
}
    </script>
</body>
</html>