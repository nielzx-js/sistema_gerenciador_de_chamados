<aside class="menu-lateral" id="menuLateral">
    <div class="menu-cabecalho">
        <h2 class="menu-logo">BLACKLOG</h2>

        <button
            type="button"
            class="menu-toggle"
            id="menuToggle"
            aria-label="Recolher menu"
            aria-expanded="true"
        >
            ☰
        </button>
    </div>

    <nav class="menu-links">
        <a href="/inicio" class="menu-link" aria-label="Início">
            <span class="menu-icone">⌂</span>
            <span class="menu-texto">Início</span>
        </a>

        <a href="/chamados" class="menu-link" aria-label="Meus chamados">
            <span class="menu-icone">▤</span>
            <span class="menu-texto">Meus chamados</span>
        </a>

        <a href="/add" class="menu-link" aria-label="Novo chamado">
            <span class="menu-icone">＋</span>
            <span class="menu-texto">Novo chamado</span>
        </a>

        <a href="/configuracoes" class="menu-link" aria-label="Desenvolvedor">
            <span class="menu-icone" aria-hidden="true">&lt;/&gt;</span>
            <span class="menu-texto">Desenvolvedor</span>
        </a>
    </nav>

    <div class="menu-rodape">
        <a href="/logout" class="menu-link" aria-label="Sair">
            <span class="menu-icone">↪</span>
            <span class="menu-texto">Sair</span>
        </a>
    </div>
</aside>

<script>
    const menuLateral = document.getElementById('menuLateral');
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = window.matchMedia('(max-width: 800px)');

    function definirMenuRecolhido(recolhido) {
        menuLateral.classList.toggle('recolhido', recolhido);
        menuToggle.setAttribute('aria-expanded', String(!recolhido));
        menuToggle.setAttribute(
            'aria-label',
            recolhido ? 'Expandir menu' : 'Recolher menu'
        );
    }

    definirMenuRecolhido(mobileMenu.matches);
    mobileMenu.addEventListener('change', event => definirMenuRecolhido(event.matches));

    menuToggle.addEventListener('click', () => {
        const recolhido = menuLateral.classList.toggle('recolhido');
        menuToggle.setAttribute('aria-expanded', String(!recolhido));
        menuToggle.setAttribute('aria-label', recolhido ? 'Expandir menu' : 'Recolher menu');
    });
</script>
