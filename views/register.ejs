<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastre-se</title>
    <link rel="stylesheet" href="css/style.css">   
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <style>
        #erro{
            color:rgba(255, 0, 0, 0.774)
        }
        #erro2{
            color:rgba(255, 0, 0, 0.774)
        }
        body{
            background-color:#0b080b;
             margin: 0;
             height: 100vh;
             display: flex;
             justify-content: center; 
             align-items: center;     
             background-image: 
            radial-gradient(circle at 20% 40%, rgba(168, 117, 160, 0.22) 0%,transparent 50%),
            radial-gradient(circle at 80% 60%,rgba(100, 80, 150, 0.18) 0%,transparent 50%);
            position: relative;
            overflow: hidden;
        }
        .registro{
            font-size:30px
        }
        .textos{
          color:#F4EDF3;
         
        }
        .button{
            border-radius: 6px;
            height: 30px;
            width:  120px;
            background-color:#211720;
            border:none;
            color:#B7A8B5;
            cursor:pointer; 

        }
        .button:hover{
            filter:brightness(1.3)
        }
        form{
            border:4px solid #51404F;
            border-radius:30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 10px;
            gap: 10px;    
            width:400px;
        
        }
       .container {
        display: flex;
     justify-content: center;
        }   
        input{
            margin-top:3px;
            border:2px solid #51404F;   
            border-radius:10px;
            height:20px;
            width: 245px;
            background-color:rgb(89, 62, 97);
            color:#B7A8B5;
        }
        .input-container{
       display: flex;
       align-items: center;
       justify-content: center; 
       gap: 8px;
       width: 100%;
        }
        .input-container input {
         margin-top: 0;
            }
            .toggle-icon {
    color: #B7A8B5;
    cursor: pointer;
    font-size: 1.1rem;
}
    </style>
</head>
<body>
    
    <div class="container">
  <form class="centro" id="cadastro">
        <h3 class="textos registro" >CADASTRE-SE</h3>
        <label for="email" class="textos"><strong>Informe seu email:</strong></label>
        <input type="email" name="email" id="email" placeholder="insira seu email." autofocus class="textos">
        
        <label for="senha" class="textos"><strong>Insira sua senha:</strong></label>
        <div class="input-container">
                <input type="password" name="senha" id="senha1" placeholder="Insira sua senha." autofocus class="textos">
              <i class="bi bi-eye-fill toggle-icon" onclick="mostrarsenha(this)"></i>
        </div>

        <label for="confirmar-senha" class="textos"><strong>Repita sua senha:</strong></label>
        <div class="input-container">
            <input name="senha" id="senha2" placeholder="Insira sua senha." class="textos" type="password">
            <i class="bi bi-eye-fill toggle-icon" onclick="mostrarsenha(this)"></i>
        </div>
        
        <p id="erro"></p><p id="erro2"></p>
      <button type="submit" class="button">Cadastre-se</button>
        <a href="/" >Já possui uma conta? Faça Login!</a>
    </form>
  
    </div>
  
    <script src="script/main.js">
   
    </script>

</body>
</html>