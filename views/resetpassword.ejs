<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="no-referrer">
    <title>Recuperar senha | BLACKLOG</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            display: flex;
            min-height: 100vh;
            align-items: center;
            justify-content: center;
            padding: 24px 16px 64px;
            background:
                radial-gradient(circle at 20% 40%, rgba(168, 117, 160, 0.18), transparent 48%),
                #0b080b;
            color: #F4EDF3;
        }

        .reset-card {
            width: min(100%, 440px);
            padding: clamp(22px, 6vw, 36px);
            border: 1px solid #51404F;
            border-radius: 16px;
            background: #160f15;
        }

        .reset-card h1 {
            margin: 0 0 10px;
            font-size: clamp(1.5rem, 5vw, 2rem);
        }

        .reset-intro,
        .reset-feedback {
            color: #B7A8B5;
            line-height: 1.6;
        }

        .reset-feedback {
            padding: 12px;
            border: 1px solid #51404F;
            border-radius: 8px;
            background: #211720;
            overflow-wrap: anywhere;
        }

        .reset-error {
            color: #F87171;
        }

        .reset-form {
            display: grid;
            gap: 10px;
            margin-top: 22px;
        }

        .reset-form label {
            margin-top: 6px;
            color: #F4EDF3;
            font-weight: 700;
        }

        .reset-form input {
            width: 100%;
            min-height: 46px;
            padding: 11px 12px;
            border: 1px solid #51404F;
            border-radius: 8px;
            background: #211720;
            color: #F4EDF3;
            font: inherit;
        }

        .reset-form input:focus {
            outline: 2px solid #A875A0;
            outline-offset: 1px;
        }

        .reset-form button {
            min-height: 46px;
            margin-top: 10px;
            border: 0;
            border-radius: 8px;
            background: #A875A0;
            color: #000000;
            font: inherit;
            font-weight: 800;
            cursor: pointer;
        }

        .reset-back {
            display: inline-block;
            margin-top: 22px;
            color: #A875A0;
        }
    </style>
</head>
<body>
    <% const feedbackMessage = typeof message === 'undefined' ? '' : message; %>
    <% const feedbackError = typeof error === 'undefined' ? '' : error; %>
    <main class="reset-card">
        <% if (mode === 'request') { %>
            <h1>Recuperar senha</h1>
            <p class="reset-intro">Informe o e-mail cadastrado. Se encontrarmos sua conta, enviaremos um link seguro para redefinir a senha.</p>

            <% if (feedbackMessage) { %>
                <p class="reset-feedback" role="status"><%= feedbackMessage %></p>
            <% } %>
            <% if (feedbackError) { %>
                <p class="reset-feedback reset-error" role="alert"><%= feedbackError %></p>
            <% } %>

            <form class="reset-form" action="/resetpassword" method="POST">
                <label for="email">E-mail da conta</label>
                <input id="email" name="email" type="email" autocomplete="email" required>
                <button type="submit">Enviar link de recuperação</button>
            </form>
        <% } else if (mode === 'new-password') { %>
            <h1>Crie uma nova senha</h1>
            <p class="reset-intro">Escolha uma senha com pelo menos 8 caracteres. Este link pode ser usado uma única vez.</p>

            <% if (feedbackError) { %>
                <p class="reset-feedback reset-error" role="alert"><%= feedbackError %></p>
            <% } %>

            <form class="reset-form" action="/resetpassword/<%= token %>" method="POST">
                <label for="senhaNova">Nova senha</label>
                <input id="senhaNova" name="senhaNova" type="password" minlength="8" autocomplete="new-password" required>
                <label for="confirmarSenha">Confirme a nova senha</label>
                <input id="confirmarSenha" name="confirmarSenha" type="password" minlength="8" autocomplete="new-password" required>
                <button type="submit">Redefinir senha</button>
            </form>
        <% } else { %>
            <h1><%= mode === 'complete' ? 'Senha atualizada' : 'Link indisponível' %></h1>
            <p class="reset-feedback <%= mode === 'invalid' ? 'reset-error' : '' %>" role="<%= mode === 'invalid' ? 'alert' : 'status' %>"><%= feedbackMessage || feedbackError %></p>
        <% } %>

        <a class="reset-back" href="/">Voltar para o login</a>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
