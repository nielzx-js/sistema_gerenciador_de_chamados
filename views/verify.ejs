<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="css/style.css">    
    <title>Verificação duas etapas</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {

            min-height: 100vh;
            padding: 20px 12px 64px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #0b080b; 
            color: #F4EDF3;
        }

        .container {
            width: 100%;
            max-width: 420px;
            padding: 2.5rem 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            background-color: #160f15; 
            border: 1px solid #51404F; 
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        }

        .title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #F4EDF3; 
            margin-bottom: 0.5rem;
        }

        .subtitle {
            font-size: 0.9rem;
            color: #B7A8B5; 
            margin-bottom: 2rem;
        }

        .form-verify {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.5rem;
        }

        .otp-container {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            width: 100%;
        }

        .otp-input {
            width: 3rem;
            height: 3.5rem;
            text-align: center;
            font-size: 1.5rem;
            font-weight: 700;
            color: #F4EDF3; 
            background-color: #211720; 
            border: 1px solid #51404F; 
            border-radius: 8px;
            outline: none;
            transition: all 0.2s ease;
        }

       
        .otp-input:focus {
            border-color: #A875A0; 
            background-color: #2c1e2a;
            box-shadow: 0 0 0 2px rgba(168, 117, 160, 0.3);
        }

        .submit-btn {
            width: 100%;
            padding: 0.85rem;
            font-size: 1rem;
            font-weight: 600;
            color: #F4EDF3;
            background-color: #A875A0;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .submit-btn:hover {
            background-color: #2c1e2a;
        }

        .back-link {
            margin-top: 1.5rem;
            text-decoration: none;
            font-size: 0.9rem;
            color: #B7A8B5; 
            transition: color 0.2s ease;
        }

        .back-link:hover {
            color: #A875A0; 
        }

        @media (max-width: 420px) {
            .container {
                padding: 1.5rem 1rem;
            }

            .otp-container {
                gap: 0.3rem;
            }

            .otp-input {
                width: min(12vw, 2.7rem);
                height: 3rem;
            }
        }
    </style>
</head>
<body>
 <main class="container">
        <h1 class="title">Código de Verificação</h1>
        <p class="subtitle">Digite o código de 6 dígitos enviado para você.</p>

        <form method="POST" action="/verify" class="form-verify" id="otpForm">
            <input type="hidden" name="codigoDigitado" id="codigoDigitado">
            <div class="otp-container">
                <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" required autocomplete="one-time-code">
                <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" required>
                <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" required>
                <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" required>
                <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" required>
                <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]" required>
            </div>

            <button type="submit" class="submit-btn">Enviar</button>
        </form>

        <a href="/" class="back-link">Voltar para o login</a>
    </main>

    <script>
        const inputs = document.querySelectorAll('.otp-input');
        const hiddenInput = document.getElementById('codigoDigitado');
        const form = document.getElementById('otpForm');

        inputs.forEach((input, index) => {
           
            input.addEventListener('input', (e) => {
                if (e.target.value.length === 1 && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && index > 0) {
                    inputs[index - 1].focus();
                }
            });
            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const pastedData = e.clipboardData.getData('text').trim();
                if (/^\d{6}$/.test(pastedData)) {
                    pastedData.split('').forEach((char, i) => {
                        if (inputs[i]) inputs[i].value = char;
                    });
                    inputs[inputs.length - 1].focus();
                }
            });
        });
       //inicio do trecho gerado por IA
    form.addEventListener('submit', (e) => {
    e.preventDefault();

    const code = Array.from(inputs)
        .map(input => input.value.trim())
        .join('');

    if (!/^\d{6}$/.test(code)) {
        alert('Digite os 6 números do código.');
        return;
    }

    hiddenInput.value = code;

    form.submit();
    //fim do trecho gerado por IA
});

    </script>
    <%- include('partials/footer') %>
</body>
</html>