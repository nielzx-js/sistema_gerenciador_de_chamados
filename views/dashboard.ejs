<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined">
    <title>Painel | BLACKLOG</title>
    <style>
        :root {
            --bg-main: #0b080b;
            --bg-card: #160f15;
            --bg-input: #211720;
            --bg-hover: #2c1e2a;
            --text-main: #F4EDF3;
            --text-secondary: #B7A8B5;
            --accent-action: #A875A0;
            --border-color: #51404F;
            --priority-critical: #F87171;
            --priority-high: #FB923C;
            --priority-medium: #FBBF24;
            --priority-low: #60A5FA;
            --resolved: #4ADE80;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: var(--bg-main);
            color: var(--text-main);
        }

        .dashboard-content {
            max-width: 1440px;
            min-height: 100vh;
            margin-left: 250px;
            padding: 40px clamp(20px, 4vw, 56px) 80px;
        }

        .dashboard-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 30px;
        }

        .dashboard-header h1 {
            margin: 0 0 8px;
            font-size: clamp(1.7rem, 4vw, 2.2rem);
        }

        .dashboard-header p,
        .ticket-description,
        .ticket-date,
        .empty-state p {
            color: var(--text-secondary);
        }

        .dashboard-header p {
            margin: 0;
        }

        .new-ticket-link,
        .status-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 10px 16px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background: var(--bg-input);
            color: var(--text-main);
            font: inherit;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: background 0.2s ease, border-color 0.2s ease;
        }

        .new-ticket-link {
            border-color: var(--accent-action);
            background: var(--accent-action);
            color: #000000;
            white-space: nowrap;
        }

        .new-ticket-link:hover,
        .status-button:hover {
            background: var(--bg-hover);
            border-color: var(--accent-action);
            color: var(--text-main);
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 34px;
        }

        .summary-card,
        .ticket-card,
        .empty-state {
            border: 1px solid var(--border-color);
            border-radius: 12px;
            background: var(--bg-card);
        }

        .summary-card {
            padding: 20px;
        }

        .summary-card span {
            display: block;
            color: var(--text-secondary);
            font-size: 0.95rem;
        }

        .summary-card strong {
            display: block;
            margin-top: 8px;
            color: var(--text-main);
            font-size: 2rem;
        }

        .summary-card.resolved strong {
            color: var(--resolved);
        }

        .section-heading {
            margin: 0 0 16px;
            font-size: 1.25rem;
        }

        .ticket-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .ticket-card {
            min-width: 0;
            padding: 20px;
            border-left: 4px solid var(--accent-action);
        }

        .ticket-card.critica { border-left-color: var(--priority-critical); }
        .ticket-card.alta { border-left-color: var(--priority-high); }
        .ticket-card.media { border-left-color: var(--priority-medium); }
        .ticket-card.baixa { border-left-color: var(--priority-low); }

        .ticket-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }

        .ticket-heading h3 {
            margin: 0;
            overflow-wrap: anywhere;
            font-size: 1.1rem;
        }

        .ticket-status {
            flex: 0 0 auto;
            padding: 5px 9px;
            border: 1px solid var(--border-color);
            border-radius: 999px;
            color: var(--text-secondary);
            font-size: 0.8rem;
        }

        .ticket-status.em_andamento { color: var(--priority-high); }
        .ticket-status.resolvido { color: var(--resolved); }

        .ticket-description {
            margin: 14px 0;
            line-height: 1.55;
            overflow-wrap: anywhere;
            white-space: pre-wrap;
        }

        .ticket-meta {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 16px;
            color: var(--text-secondary);
            font-size: 0.88rem;
        }

        .ticket-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .status-button {
            min-height: 38px;
            padding: 8px 12px;
            font-size: 0.9rem;
        }

        .status-button.resolve {
            border-color: var(--resolved);
            color: var(--resolved);
        }

        .status-button.resolve:hover {
            background: rgba(74, 222, 128, 0.12);
        }

        .status-button.analyze {
            border-color: var(--accent-action);
            color: var(--text-main);
        }

        .empty-state {
            padding: 30px 20px;
            text-align: center;
        }

        .empty-state h3 {
            margin: 0 0 8px;
        }

        .empty-state p {
            margin: 0 0 18px;
        }

        @media (max-width: 800px) {
            .dashboard-content {
                padding: 30px 22px 80px;
            }

            .ticket-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .dashboard-content {
                margin-left: 72px;
                padding: 24px 14px 76px;
            }

            .dashboard-header {
                align-items: stretch;
                flex-direction: column;
                margin-bottom: 22px;
            }

            .new-ticket-link {
                align-self: flex-start;
            }

            .summary-grid {
                grid-template-columns: 1fr;
                gap: 10px;
                margin-bottom: 26px;
            }

            .summary-card {
                padding: 15px 18px;
            }

            .summary-card strong {
                font-size: 1.7rem;
            }

            .ticket-card {
                padding: 16px;
            }

            .ticket-heading {
                flex-direction: column;
                gap: 8px;
            }
        }

        @media (max-width: 420px) {
            .dashboard-content {
                margin-left: 58px;
                padding-right: 10px;
                padding-left: 10px;
            }
        }
    </style>
</head>
<body>
    <main class="dashboard-content">
        <header class="dashboard-header">
            <div>
                <h1>Olá, aqui está seu painel</h1>
                <p>Acompanhe seus chamados e atualize o andamento por aqui.</p>
            </div>
            <a class="new-ticket-link" href="/add">＋ Novo chamado</a>
        </header>

        <section class="summary-grid" aria-label="Resumo dos chamados">
            <article class="summary-card">
                <span>Total de chamados</span>
                <strong><%= totalChamados %></strong>
            </article>
            <article class="summary-card resolved">
                <span>Chamados resolvidos</span>
                <strong><%= chamadosResolvidos %></strong>
            </article>
            <article class="summary-card">
                <span>Em análise</span>
                <strong><%= chamados.filter(chamado => chamado.status === 'em_andamento').length %></strong>
            </article>
        </section>

        <section aria-labelledby="tickets-title">
            <h2 class="section-heading" id="tickets-title">Seus chamados</h2>

            <% if (chamados.length === 0) { %>
                <div class="empty-state">
                    <h3>Nenhum chamado por aqui ainda</h3>
                    <p>Crie seu primeiro chamado para acompanhar tudo neste painel.</p>
                    <a class="new-ticket-link" href="/add">Criar chamado</a>
                </div>
            <% } else { %>
                <div class="ticket-grid">
                    <% chamados.forEach(chamado => { %>
                        <article class="ticket-card <%= chamado.prioridade %>">
                            <div class="ticket-heading">
                                <h3><%= chamado.titulo %></h3>
                                <span class="ticket-status <%= chamado.status %>">
                                    <%= chamado.status === 'em_andamento' ? 'Em análise' : chamado.status === 'resolvido' ? 'Resolvido' : chamado.status === 'aberto' ? 'Aberto' : chamado.status %>
                                </span>
                            </div>
                            <p class="ticket-description"><%= chamado.descricao || 'Sem descrição.' %></p>
                            <div class="ticket-meta">
                                <span>Prioridade: <%= chamado.prioridade %></span>
                                <span class="ticket-date">Criado em: <%= new Date(chamado.criado_em).toLocaleDateString('pt-BR') %></span>
                            </div>
                            <div class="ticket-actions">
                                <% if (chamado.status !== 'em_andamento') { %>
                                    <form action="/chamados/<%= chamado.id %>/status" method="POST">
                                        <input type="hidden" name="status" value="em_andamento">
                                        <button class="status-button analyze" type="submit">
                                            <%= chamado.status === 'resolvido' ? 'Reabrir para análise' : 'Colocar em análise' %>
                                        </button>
                                    </form>
                                <% } %>
                                <% if (chamado.status !== 'resolvido') { %>
                                    <form action="/chamados/<%= chamado.id %>/status" method="POST">
                                        <input type="hidden" name="status" value="resolvido">
                                        <button class="status-button resolve" type="submit">Marcar como resolvido</button>
                                    </form>
                                <% } %>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/menu') %>
</body>
</html>
